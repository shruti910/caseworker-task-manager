# ==============================================================================
# HMCTS DTS Caseworker Task Management System - Environment Configuration
# ==============================================================================

# Backend Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration (Only PostgreSQL is used)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caseworker_tasks
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & Cross-Origin Resource Sharing (CORS)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Configuration (leave empty to use default Vite reverse proxy)
VITE_API_BASE_URL=

